name = "xiqing-agri-website"
compatibility_date = "2026-08-25"
main = "src/worker.ts"

[assets]
directory = "./dist"
binding = "ASSETS"

# Copy this file to wrangler.toml only after creating the named resources.
# Optional standalone Worker adapter. Production uses Cloudflare Pages + Pages Functions.

[[r2_buckets]]
binding = "MEDIA_BUCKET"
bucket_name = "xiqing-agri-media"
preview_bucket_name = "xiqing-agri-media-preview"

[[d1_databases]]
binding = "DB"
database_name = "xiqing-agri-media"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
preview_database_id = "REPLACE_WITH_D1_PREVIEW_DATABASE_ID"

[vars]
MEDIA_PUBLIC_BASE_URL = "https://media.xiqingagri.com"
DEFAULT_TIMEZONE_OFFSET = "+08:00"

# If this optional Worker is deployed, set this as an encrypted Worker secret, not in this file:
# MEDIA_UPLOAD_TOKEN
