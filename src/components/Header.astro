---
const pathname = Astro.url.pathname;

const links = [
	{ href: '/', label: '首页' },
	{ href: '/experiments', label: '实验记录' },
	{ href: '/about', label: '关于曦清' },
];

const isActive = (href: string) =>
	href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header">
	<a class="skip-link" href="#main-content">跳到主要内容</a>
	<div class="site-header__inner shell">
		<a class="wordmark" href="/" aria-label="曦清农业首页"><span>曦清</span><small>XIQING AGRI</small></a>
		<nav aria-label="主导航">
			{links.map((link) => (
				<a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>
			))}
		</nav>
	</div>
</header>
