---
const pathname = Astro.url.pathname;

interface Props {
	locale?: 'zh' | 'en';
	alternatePath?: string;
	alternateLocale?: 'zh' | 'en';
}

const { locale = 'zh', alternatePath, alternateLocale = locale === 'zh' ? 'en' : 'zh' } = Astro.props;
const isEnglish = locale === 'en';
const prefix = isEnglish ? '/en' : '';
const links = isEnglish
	? [
		{ href: prefix, label: 'Home' },
		{ href: `${prefix}/experiments`, label: 'Experiments' },
		{ href: `${prefix}/trace`, label: 'Trace' },
		{ href: `${prefix}/about`, label: 'About' },
	]
	: [
		{ href: '/', label: '首页' },
		{ href: '/experiments', label: '实验记录' },
		{ href: '/trace', label: '产品追溯' },
		{ href: '/about', label: '关于曦清' },
	];

const normalizePath = (path: string) => path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path;
const currentPath = normalizePath(pathname);
const isActive = (href: string) => {
	const normalizedHref = normalizePath(href);
	return normalizedHref === '/' || normalizedHref === '/en'
		? currentPath === normalizedHref
		: currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
};
---

<header class="site-header">
	<a class="skip-link" href="#main-content">{isEnglish ? 'Skip to main content' : '跳到主要内容'}</a>
	<div class="site-header__inner shell">
		<a class="wordmark" href={isEnglish ? '/en' : '/'} aria-label={isEnglish ? 'XIQING AGRI home' : '曦清农业首页'}><span>曦清</span><small>XIQING AGRI</small></a>
		<div class="site-header__actions">
			<nav aria-label={isEnglish ? 'Primary navigation' : '主导航'}>
				{links.map((link) => (
					<a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>
				))}
			</nav>
			<a
				class="field-management-link"
				href="https://control.xiqingagri.com/"
				target="_blank"
				rel="noopener noreferrer"
				title={isEnglish ? 'Private live readings, historical data and maintenance; sign-in required' : '私有实时读数、历史数据与维护；需要登录'}
				aria-label={isEnglish ? 'Private field data and maintenance, sign-in required' : '私有现场数据与维护，需要登录'}
			>
				<span class="field-management-link__full">{isEnglish ? 'Field management' : '现场管理'}</span>
				<span class="field-management-link__compact" aria-hidden="true">{isEnglish ? 'Field' : '管理'}</span>
				<span aria-hidden="true">↗</span>
			</a>
			{alternatePath && (
				<a
					class="language-switch"
					href={alternatePath}
					lang={alternateLocale === 'en' ? 'en' : 'zh-CN'}
					hreflang={alternateLocale === 'en' ? 'en' : 'zh-CN'}
					aria-label={isEnglish ? '切换到中文' : 'Switch to English'}
				>
					{isEnglish ? '中文' : 'EN'}
				</a>
			)}
		</div>
	</div>
</header>
