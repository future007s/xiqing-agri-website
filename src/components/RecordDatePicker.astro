---
interface Props { experimentId: string; slug: string }
const {experimentId, slug} = Astro.props;
---
<section class="record-date-picker" data-record-browser data-experiment-id={experimentId} data-record-base={`/record-days/${slug}`} aria-label="按日期查看记录">
  <div class="record-date-picker__form">
    <span>记录日期</span>
    <button type="button" data-record-previous aria-label="较早一天的记录" disabled>←</button>
    <button type="button" data-calendar-trigger aria-label="选择记录日期" aria-haspopup="dialog" aria-expanded="false" disabled><span data-record-selected>读取中…</span><span aria-hidden="true"> ▦</span></button>
    <button type="button" data-record-next aria-label="较新一天的记录" disabled>→</button>
    <button type="button" data-record-retry hidden>重试</button>
  </div>
  <p role="status" data-record-status>正在读取日期…</p>
  <dialog class="record-calendar" aria-labelledby="record-calendar-title" data-record-calendar>
    <div class="record-calendar__top"><h2 id="record-calendar-title">选择记录日期</h2><button type="button" data-calendar-close aria-label="关闭日历">×</button></div>
    <div class="record-calendar__month"><button type="button" data-calendar-previous aria-label="上个月">←</button><h3 tabindex="-1" data-calendar-month aria-live="polite"></h3><button type="button" data-calendar-next aria-label="下个月">→</button></div>
    <table role="grid" aria-label="有记录的日期"><thead><tr>{['一','二','三','四','五','六','日'].map(day=><th scope="col">{day}</th>)}</tr></thead><tbody data-calendar-days></tbody></table>
    <p class="record-calendar__hint">灰色日期无记录</p>
  </dialog>
  <noscript><p>请启用 JavaScript 选择日期并读取当天记录。</p></noscript>
</section>
<script>
  import { initRecordBrowser } from '../lib/record-day-browser';
  document.querySelectorAll<HTMLElement>('[data-record-browser]').forEach(initRecordBrowser);
</script>
<style is:global>
  .record-date-picker { --record-control-bg:#f2f0e9; --record-control-ink:#171915; --record-control-line:#61665b; --record-control-muted:#696b62; padding:0; }
  .record-date-picker.is-floating { position:fixed; top:calc(env(safe-area-inset-top, 0px) + .6rem); right:max(.75rem,calc((100vw - 1200px)/2)); z-index:30; width:max-content; max-width:calc(100vw - 1.5rem); padding:.35rem .45rem; border:1px solid var(--record-control-line); background:var(--record-control-bg); color:var(--record-control-ink); box-shadow:0 4px 18px rgb(0 0 0 / .18); }
  .record-date-picker__form { display:flex; align-items:center; flex-wrap:wrap; gap:.4rem; }
  .record-date-picker.is-floating .record-date-picker__form { flex-wrap:nowrap; gap:.25rem; }
  .record-date-picker__form > span { font-size:.8rem; margin-right:.3rem; }
  .record-date-picker__form button { min-height:44px; min-width:44px; border:1px solid var(--record-control-line); background:var(--record-control-bg); color:var(--record-control-ink); padding:.5rem .65rem; font:inherit; cursor:pointer; }
  .record-date-picker__form button:disabled { color:var(--record-control-muted); cursor:default; }
  .record-date-picker button:focus-visible { outline:2px solid var(--signal); outline-offset:2px; }
  .record-date-picker [role=status] { margin:.35rem 0 0; font-size:.75rem; }
  .record-date-picker.is-floating .record-date-picker__form > span,
  .record-date-picker.is-floating [role=status] { display:none; }
  .record-calendar { width:min(24rem,calc(100% - 2rem)); max-height:calc(100dvh - 2rem); overflow:auto; margin:auto; padding:1rem; border:1px solid var(--record-control-line); background:var(--record-control-bg); color:var(--record-control-ink); }
  .record-calendar::backdrop { background:rgb(0 0 0 / .4); }
  .record-calendar__top,.record-calendar__month { display:flex; align-items:center; justify-content:space-between; gap:.5rem; }
  .record-calendar__top h2 { font-size:1rem; margin:0; }
  .record-calendar__month h3 { font-size:1rem; margin:0; }
  .record-calendar button { min-width:40px; min-height:44px; padding:.3rem; color:inherit; background:transparent; border:1px solid transparent; font:inherit; cursor:pointer; }
  .record-calendar button:disabled { color:var(--record-control-muted); background:rgb(120 120 120 / .07); cursor:default; }
  .record-calendar table { width:100%; border-collapse:separate; border-spacing:2px; table-layout:fixed; margin-top:.5rem; }
  .record-calendar th { font-size:.8rem; font-weight:400; padding-block:.25rem; }
  .record-calendar td { padding:0; text-align:center; }
  .record-calendar td button { width:100%; min-width:0; }
  .record-calendar td button:not(:disabled) { background:#dbe3c5; color:#202719; border-color:#879865; }
  .record-calendar td button[aria-current=date] { background:#435530; color:white; border-color:#435530; }
  .record-calendar__hint { font-size:.75rem; margin:.5rem 0 0; color:var(--record-control-muted); }
  .record-data.record-data--compact { padding-block:1.5rem; }
  .record-data.record-data--compact .metric-grid--record { grid-template-columns:repeat(4,minmax(0,1fr)); }
  .record-body.record-body--daily { padding-block:2rem; }
  .record-summary-header { display:flex; align-items:start; justify-content:space-between; flex-wrap:wrap; gap:1rem; margin-bottom:1.2rem; }
  .record-summary-header h1 { font-size:clamp(1.4rem,2.5vw,2rem); margin:.35rem 0; line-height:1.2; }
  .record-summary-header .eyebrow { overflow-wrap:anywhere; }
  .record-summary-header p { margin:0; }
  .record-summary-start { font-size:.75rem; color:#bfc2b8; }
  .record-data--compact .section-heading { margin-bottom:.8rem; }
  .record-data--compact #data-title { font-size:1.05rem; }
  .record-data.record-data--compact .metric-card { padding:.8rem; grid-column:auto; min-height:110px; }
  .record-data--compact .metric-card strong { font-size:clamp(1.6rem,3vw,2.8rem); }
  .record-day-content { min-height:12rem; }
  .record-day-content h2 { margin-top:0; }
  .record-day-item { margin-bottom:2.5rem; }
  .record-day-item h3 { margin-top:0; }
  .record-day-environment { display:flex; flex-wrap:wrap; gap:1rem 2rem; margin:0; }
  .record-day-environment div { display:grid; gap:.3rem; }
  .record-day-environment dt { font-size:.9rem; }
  .record-day-environment dd { margin:0; font-size:1.5rem; font-weight:600; }
  .record-observation { margin-block:1.8rem; }
  .record-observation figure { margin:1rem 0; }
  .record-observation img { display:block; width:100%; height:auto; }
  .record-day-batch-context { margin-bottom:1.5rem; }
  @media(prefers-color-scheme:dark) {
    .record-date-picker { --record-control-bg:#172129; --record-control-ink:#eaf0f4; --record-control-line:#72838d; --record-control-muted:#a0adb5; }
  }
  @media(max-width:480px) {
    .record-summary-header { gap:.8rem; }
    .record-data.record-data--compact .metric-grid--record { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .record-date-picker { width:100%; }
    .record-date-picker__form { gap:.3rem; }
    .record-date-picker.is-floating { right:max(.5rem,env(safe-area-inset-right,0px)); }
    .record-date-picker.is-floating .record-date-picker__form > span { display:none; }
  }
</style>
