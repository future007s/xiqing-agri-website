---
import { getCollection } from 'astro:content';
import ExperimentCard from '../../components/ExperimentCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortExperimentsNewestFirst } from '../../lib/experiments';

const experiments = (await getCollection('experiments')).sort(sortExperimentsNewestFirst);
---

<BaseLayout
	title="实验记录 | 曦清农业 XIQING AGRI"
	description="按时间查看曦清农业的气雾培、自然光与自动控制实验记录；成功与失败均持续保留。"
>
	<main>
		<header class="page-hero shell">
			<p class="eyebrow">EXPERIMENT DATABASE</p>
			<div class="page-hero__heading"><h1>实验记录</h1><p>{String(experiments.length).padStart(2, '0')} RECORDS</p></div>
			<p class="page-hero__intro">每条记录由 Markdown 生成。设计值、实测值与待验证假设分开呈现；未测量的数据不会用 0 代替。</p>
		</header>
		<section class="section section--tint" aria-label="全部实验">
			<div class="shell experiment-list">
				{experiments.map((experiment) => <ExperimentCard experiment={experiment} />)}
			</div>
		</section>
	</main>
</BaseLayout>
