---
import { getCollection } from 'astro:content';
import { isPublicExperiment } from '../../../lib/public-records';
import ExperimentCard from '../../../components/ExperimentCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { sortExperimentsNewestFirst } from '../../../lib/experiments';

const translated = (await getCollection('experimentsEn', isPublicExperiment)).sort(sortExperimentsNewestFirst);
const experiments = translated;
---

<BaseLayout
	title="Experiment Records | XIQING AGRI"
	description="Browse XIQING AGRI experiments in aeroponics, natural light and automated control. Successful and failed trials remain part of the record."
	locale="en"
	alternatePath="/experiments"
>
	<main>
		<header class="page-hero shell">
			<p class="eyebrow">EXPERIMENT DATABASE</p>
			<div class="page-hero__heading"><h1>Experiments</h1><p>{String(experiments.length).padStart(2, '0')} RECORDS</p></div>
			<p class="page-hero__intro">Growing observations, daily work and field photographs, organized by date.</p>
		</header>
		<section class="section section--tint" aria-label="All experiments">
			<div class="shell experiment-list">
				{experiments.map((experiment) => <ExperimentCard experiment={experiment} locale="en" />)}
			</div>
		</section>
	</main>
</BaseLayout>
