---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import MetricCard from '../../../components/MetricCard.astro';
import ExperimentLayout from '../../../layouts/ExperimentLayout.astro';
import { displayValue, statusLabelsEn } from '../../../lib/experiments';

export async function getStaticPaths() {
	const experiments = await getCollection('experimentsEn');
	return experiments.map((experiment) => ({ params: { slug: experiment.id }, props: { experiment } }));
}

interface Props {
	experiment: CollectionEntry<'experimentsEn'>;
}

const { experiment } = Astro.props;
const { data } = experiment;
const { Content } = await render(experiment);
const description = `${data.id}: ${data.title}. An open record of the experiment design, current status and measured results.`;
const eventStatusLabels = { planned: 'Planned', completed: 'Completed', failed: 'Failed', paused: 'Paused' };
const telemetryStatusLabels = { observed: 'Observed', partial: 'Partial', pending: 'Pending sync', invalid: 'Invalid' };
const qualityLabels = { observed: 'Observed', estimated: 'Estimated', pending: 'Pending', invalid: 'Invalid' };
const severityLabels = { info: 'Record', attention: 'Attention', critical: 'Critical' };
const publicMedia = data.media.filter((item) => item.visibility === 'public' && item.reviewStatus === 'confirmed');
const publicObservations = data.observations.filter((item) => item.reviewStatus === 'confirmed');
const publicAnalyses = data.analyses.filter((item) => item.reviewStatus === 'confirmed');
---

<ExperimentLayout id={data.id} title={data.title} tower={data.tower} status={data.status} startDate={data.startDate} description={description} locale="en">
	<section class="record-data section--dark" aria-labelledby="data-title">
		<div class="shell">
			<div class="section-heading section-heading--light section-heading--row">
				<div><p class="eyebrow">MEASUREMENTS</p><h2 id="data-title">Data summary</h2></div>
				<p class="data-note">NOT MEASURED ≠ ZERO · EMPTY VALUES ARE SHOWN AS “PENDING”</p>
			</div>
			<div class="metric-grid metric-grid--record">
				<MetricCard label="Status" value={statusLabelsEn[data.status]} kind="CURRENT" />
				<MetricCard label="Tower height" value={displayValue(data.towerHeightM, 'm', 'Pending')} kind="DESIGN" />
				<MetricCard label="Plant sites" value={displayValue(data.designPlants, '', 'Pending')} kind="DESIGN" />
				<MetricCard label="Crop" value={data.plant} kind="PLANNED" />
				<MetricCard label="Survival rate" value={displayValue(data.survivalRate, '%', 'Pending')} kind="MEASURED" pending={data.survivalRate == null} />
				<MetricCard label="Yield" value={displayValue(data.yieldKg, 'kg', 'Pending')} kind="MEASURED" pending={data.yieldKg == null} />
				<MetricCard label="Energy" value={displayValue(data.electricityKwh, 'kWh', 'Pending')} kind="MEASURED" pending={data.electricityKwh == null} />
				<MetricCard label="Water" value={displayValue(data.waterL, 'L', 'Pending')} kind="MEASURED" pending={data.waterL == null} />
				<MetricCard label="Cost" value={displayValue(data.costCny, 'CNY', 'Pending')} kind="MEASURED" pending={data.costCny == null} />
			</div>
		</div>
	</section>

	<section class="record-body shell">
		<article class="prose"><Content /></article>
		<aside class="record-aside" aria-label="Data rules">
			<p class="eyebrow">DATA RULES</p>
			<ul><li>Evidence &gt; promotion</li><li>Measured &gt; assumed</li><li>Unknown ≠ zero</li><li>Design ≠ measured</li><li>Failed data remains</li></ul>
		</aside>
	</section>

	{data.objectives.length > 0 && (
		<section class="record-section shell" aria-labelledby="objectives-title">
			<div class="record-section__heading"><p class="eyebrow">EXPERIMENT SCOPE</p><h2 id="objectives-title">Objectives</h2></div>
			<ol class="record-objectives">
				{data.objectives.map((objective, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{objective}</li>)}
			</ol>
		</section>
	)}

	{data.sensors.length > 0 && (
		<section class="record-section record-section--tint" aria-labelledby="sensors-title">
			<div class="shell">
				<div class="record-section__heading"><p class="eyebrow">INSTRUMENTATION</p><h2 id="sensors-title">Sensors and data sources</h2></div>
				<div class="record-table-wrap">
					<table class="record-table">
						<thead><tr><th scope="col">ID</th><th scope="col">Sensor</th><th scope="col">Protocol</th><th scope="col">Location</th><th scope="col">Unit</th><th scope="col">Status</th></tr></thead>
						<tbody>
							{data.sensors.map((sensor) => <tr><th scope="row">{sensor.id}</th><td>{sensor.name}<small>{sensor.kind}</small></td><td>{sensor.protocol ?? 'Pending'}</td><td>{sensor.location ?? 'Pending'}</td><td>{sensor.unit ?? '—'}</td><td><span class="record-badge">{sensor.status}</span></td></tr>)}
						</tbody>
					</table>
				</div>
			</div>
		</section>
	)}

	{data.events.length > 0 && (
		<section class="record-section shell" aria-labelledby="events-title">
			<div class="record-section__heading"><p class="eyebrow">EVENT LOG</p><h2 id="events-title">Experiment events</h2></div>
			<ol class="record-timeline">
				{data.events.map((event) => <li>
					<div class="record-timeline__meta"><span>{event.id}</span><time datetime={event.at}>{event.at}</time></div>
					<div><h3>{event.title}</h3><p>{event.summary ?? 'No event description yet.'}</p></div>
					<div class="record-timeline__status"><span>{event.type}</span><span>{eventStatusLabels[event.status]}</span>{event.operator && <span>{event.operator}</span>}</div>
				</li>)}
			</ol>
		</section>
	)}

	{data.telemetry.length > 0 && (
		<section class="record-section record-section--dark" aria-labelledby="telemetry-title">
			<div class="shell">
				<div class="record-section__heading record-section__heading--light"><p class="eyebrow">TELEMETRY SNAPSHOTS</p><h2 id="telemetry-title">Automated data summary</h2></div>
				<div class="telemetry-list">
					{data.telemetry.map((snapshot) => <article class="telemetry-snapshot">
						<header><div><time datetime={snapshot.at}>{snapshot.at}</time><span>{snapshot.source}</span></div><span class="record-badge record-badge--dark">{telemetryStatusLabels[snapshot.status]}</span></header>
						<dl>{snapshot.metrics.map((metric) => <div><dt>{metric.label}<small>{metric.key}</small></dt><dd>{metric.value}{metric.unit && <span>{metric.unit}</span>}<small>{qualityLabels[metric.quality]}</small></dd></div>)}</dl>
					</article>)}
				</div>
			</div>
		</section>
	)}

	{publicObservations.length > 0 && (
		<section class="record-section record-section--tint" aria-labelledby="observations-title">
			<div class="shell">
				<div class="record-section__heading"><p class="eyebrow">FIELD OBSERVATIONS</p><h2 id="observations-title">Manual observations</h2></div>
				<div class="observation-list">
					{publicObservations.map((observation) => <article class="observation-card">
						<header><span>{observation.category}</span><time datetime={observation.at}>{observation.at}</time><span class:list={['record-badge', `record-badge--${observation.severity}`]}>{severityLabels[observation.severity]}</span></header>
						<h3>{observation.subject}</h3><p>{observation.summary}</p>{observation.detail && <p class="observation-card__detail">{observation.detail}</p>}
					</article>)}
				</div>
			</div>
		</section>
	)}

	{publicAnalyses.length > 0 && (
		<section class="record-section shell" aria-labelledby="analysis-title">
			<div class="record-section__heading"><p class="eyebrow">PLANT ANALYSIS</p><h2 id="analysis-title">Plant and image analysis</h2></div>
			<div class="analysis-list">
				{publicAnalyses.map((analysis) => <article class="analysis-card"><header><span>{analysis.method}</span><time datetime={analysis.at}>{analysis.at}</time></header><h3>{analysis.subject}</h3><p>{analysis.result}</p>{analysis.confidence != null && <small>Confidence {Math.round(analysis.confidence * 100)}%</small>}</article>)}
			</div>
		</section>
	)}

	<section class="record-section record-section--tint" aria-labelledby="media-title" data-media-shell data-experiment-id={data.id} hidden={publicMedia.length === 0}>
		<div class="shell">
			<div class="record-section__heading"><p class="eyebrow">FIELD MEDIA</p><h2 id="media-title">Photos and videos</h2></div>
			<div class="media-grid" data-media-grid>
				{publicMedia.map((item) => <figure class:list={['media-card', `media-card--${item.kind}`]} data-media-id={item.id}>
					{item.kind === 'image' ? <a href={item.src} target="_blank" rel="noreferrer"><img src={item.thumbnail ?? item.src} alt={item.alt} loading="lazy" decoding="async" /></a> : <video controls preload="metadata" poster={item.poster ?? item.thumbnail}><source src={item.src} /></video>}
					<figcaption><div><strong>{item.caption}</strong><span>{item.at}</span></div>{(item.eventId || item.plantId) && <small>{item.eventId && `Event ${item.eventId}`}{item.eventId && item.plantId && ' · '}{item.plantId && `Plant ${item.plantId}`}</small>}</figcaption>
				</figure>)}
			</div>
			<p class="media-empty" data-media-empty hidden>No reviewed public media yet.</p>
		</div>
	</section>
</ExperimentLayout>

<script is:inline define:vars={{ experimentId: data.id }}>
	const mediaShell = document.querySelector('[data-media-shell]');
	const mediaGrid = document.querySelector('[data-media-grid]');
	const mediaEmpty = document.querySelector('[data-media-empty]');

	const addDynamicMedia = (item) => {
		if (!mediaGrid || !item?.id || !item?.src || !item?.kind || mediaGrid.querySelector(`[data-media-id="${CSS.escape(item.id)}"]`)) return;
		const figure = document.createElement('figure');
		figure.className = `media-card media-card--${item.kind}`;
		figure.dataset.mediaId = item.id;
		if (item.kind === 'image') {
			const link = document.createElement('a');
			link.href = item.src;
			link.target = '_blank';
			link.rel = 'noreferrer';
			const image = document.createElement('img');
			image.src = item.thumbnail || item.src;
			image.alt = item.alt || item.caption || 'Experiment media';
			image.loading = 'lazy';
			image.decoding = 'async';
			link.append(image);
			figure.append(link);
		} else {
			const video = document.createElement('video');
			video.controls = true;
			video.preload = 'metadata';
			if (item.poster || item.thumbnail) video.poster = item.poster || item.thumbnail;
			const source = document.createElement('source');
			source.src = item.src;
			video.append(source);
			figure.append(video);
		}
		const caption = document.createElement('figcaption');
		const captionRow = document.createElement('div');
		const title = document.createElement('strong');
		title.textContent = item.caption || 'Untitled media';
		const date = document.createElement('span');
		date.textContent = item.at || '';
		captionRow.append(title, date);
		caption.append(captionRow);
		if (item.eventId || item.plantId) {
			const relation = document.createElement('small');
			relation.textContent = [item.eventId && `Event ${item.eventId}`, item.plantId && `Plant ${item.plantId}`].filter(Boolean).join(' · ');
			caption.append(relation);
		}
		figure.append(caption);
		mediaGrid.append(figure);
	};

	const loadDynamicMedia = async () => {
		try {
			const response = await fetch(`/api/experiments/${encodeURIComponent(experimentId)}/media`, { headers: { Accept: 'application/json' } });
			if (!response.ok) return;
			const payload = await response.json();
			const items = Array.isArray(payload) ? payload : payload.media;
			if (!Array.isArray(items)) return;
			items.forEach(addDynamicMedia);
			if (items.length > 0 && mediaShell) mediaShell.hidden = false;
			if (mediaGrid && mediaGrid.children.length === 0 && mediaEmpty) mediaEmpty.hidden = false;
		} catch {
			// The static site remains usable when the optional media API is not configured.
		}
	};

	void loadDynamicMedia();
</script>
