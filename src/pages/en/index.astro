---
import { getCollection } from 'astro:content';
import ExperimentCard from '../../components/ExperimentCard.astro';
import MetricCard from '../../components/MetricCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { displayValue, sortExperimentsNewestFirst, statusLabelsEn } from '../../lib/experiments';

const experiments = (await getCollection('experimentsEn')).sort(sortExperimentsNewestFirst);
const featuredExperiment = experiments.find(({ data }) => data.featured) ?? experiments[0];
const latestExperiments = experiments.slice(0, 3);
const description =
	'XIQING AGRI openly documents aeroponics, natural-light cultivation, sensors and automation through real costs, energy use, yields, failures and engineering iterations.';
---

<BaseLayout title="XIQING AGRI | Verifiable Agricultural Engineering" description={description} locale="en" alternatePath="/">
	<main>
		<section class="hero shell" aria-labelledby="hero-title">
			<div class="hero__topline">
				<span>FIELD LAB / JIMO · QINGDAO</span>
				<span>EST. 2026</span>
			</div>
			<div class="hero__body">
				<div>
					<p class="eyebrow">XIQING AGRI · OPEN EXPERIMENT LOG</p>
					<h1 id="hero-title">XIQING <span>AGRI</span></h1>
					<p class="hero__claim">Engineering agriculture through verifiable experiments</p>
				</div>
				<div class="hero__intro">
					<p class="formula">NATURAL LIGHT × AEROPONICS × AUTOMATION × REAL DATA</p>
					<p>
						XIQING AGRI is building a low-cost automated growing system from the ground up.<br />
						We publish the design, cost, energy use, yield, failures and every iteration.
					</p>
					<a class="button" href="/en/experiments/t01-001">
						View the current experiment <span aria-hidden="true">↗</span>
					</a>
				</div>
			</div>
			<div class="hero__index" aria-hidden="true">
				<span>01</span><span>OPEN EXPERIMENT DATABASE</span><span>SCROLL TO VERIFY</span>
			</div>
		</section>

		{featuredExperiment && (
			<section class="section section--dark" aria-labelledby="current-title">
				<div class="shell">
					<div class="section-heading section-heading--light">
						<p class="eyebrow">CURRENT EXPERIMENT</p>
						<h2 id="current-title">In progress</h2>
						<span class="status-dot">{statusLabelsEn[featuredExperiment.data.status]}</span>
					</div>

					<div class="experiment-lead">
						<div>
							<p class="experiment-code">{featuredExperiment.data.tower} / {featuredExperiment.data.id}</p>
							<h3>{featuredExperiment.data.title}</h3>
						</div>
						<p>
							This page currently shows confirmed design parameters only. Measured results will be added as they are produced, and failed trials will remain public.
						</p>
					</div>

					<div class="metric-grid">
						<MetricCard label="Tower height" value={displayValue(featuredExperiment.data.towerHeightM, 'm', 'Pending')} kind="DESIGN" />
						<MetricCard label="Plant sites" value={displayValue(featuredExperiment.data.designPlants, '', 'Pending')} kind="DESIGN" />
						<MetricCard label="Status" value={statusLabelsEn[featuredExperiment.data.status]} kind="CURRENT" />
						<MetricCard label="Measured data" value="Pending" kind="MEASURED" pending />
					</div>

					<a class="text-link text-link--light" href={`/en/experiments/${featuredExperiment.id}`}>
						View the full experiment record <span aria-hidden="true">→</span>
					</a>
				</div>
			</section>
		)}

		<section class="section shell" aria-labelledby="verify-title">
			<div class="section-heading">
				<p class="eyebrow">WHAT WE VERIFY</p>
				<h2 id="verify-title">The questions behind every build</h2>
			</div>
			<div class="question-grid">
				<article><span>01</span><h3>Low cost</h3><p>Can the equipment operate reliably with a restrained initial investment?</p></article>
				<article><span>02</span><h3>Modular</h3><p>Can one tower become a repeatable multi-tower system?</p></article>
				<article><span>03</span><h3>Automated</h3><p>Can nutrients, pressure and the environment be monitored and controlled continuously?</p></article>
				<article><span>04</span><h3>Verifiable</h3><p>Can every conclusion be supported by measured evidence?</p></article>
			</div>
		</section>

		<section class="section section--tint" aria-labelledby="latest-title">
			<div class="shell">
				<div class="section-heading section-heading--row">
					<div><p class="eyebrow">LATEST EXPERIMENTS</p><h2 id="latest-title">Experiment records</h2></div>
					<a class="text-link" href="/en/experiments">View all records <span aria-hidden="true">→</span></a>
				</div>
				<div class="experiment-list">
					{latestExperiments.map((experiment) => <ExperimentCard experiment={experiment} locale="en" />)}
				</div>
			</div>
		</section>
	</main>
</BaseLayout>
