---
import { getCollection } from 'astro:content';
import { isPublicTraceBatch } from '../../../lib/public-records';
import TraceBatchCard from '../../../components/TraceBatchCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { sortTraceBatchesNewestFirst } from '../../../lib/traceability';

const translated = (await getCollection('traceBatchesEn', isPublicTraceBatch)).sort(sortTraceBatchesNewestFirst);
const batches = translated;
---

<BaseLayout
	title="Traceability | XIQING AGRI"
	description="Browse production batches, transplanting and daily growing records."
	locale="en"
	alternatePath="/trace"
>
	<main>
		<header class="page-hero shell">
			<p class="eyebrow">TRACEABILITY RECORDS</p>
			<div class="page-hero__heading"><h1>Traceability</h1><p>{String(batches.length).padStart(2, '0')} BATCHES</p></div>
			<p class="page-hero__intro">Follow each batch from transplanting through daily growing records.</p>
		</header>
		<section class="section section--tint" aria-label="Public production batches">
			<div class="shell trace-list">{batches.map((batch) => <TraceBatchCard batch={batch} locale="en" />)}</div>
		</section>
	</main>
</BaseLayout>
