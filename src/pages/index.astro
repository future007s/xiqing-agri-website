---
import { getCollection } from 'astro:content';
import { currentGrowingRecord, isPublicExperiment, isPublicTraceBatch, productionBatchesForExperiment } from '../lib/public-records';
import ExperimentCard from '../components/ExperimentCard.astro';
import MetricCard from '../components/MetricCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, sortExperimentsNewestFirst, statusLabels } from '../lib/experiments';

const experiments = (await getCollection('experiments', isPublicExperiment)).sort(sortExperimentsNewestFirst);
const featuredExperiment = experiments.find(({ data }) => data.featured) ?? experiments[0];
const latestExperiments = experiments.slice(0, 3);
const growing = featuredExperiment ? currentGrowingRecord(featuredExperiment) : undefined;
const currentBatch = featuredExperiment ? productionBatchesForExperiment(featuredExperiment, await getCollection('traceBatches', isPublicTraceBatch))[0] : undefined;

const description =
	'曦清农业公开记录气雾培、自然光、传感器与自动控制系统的真实成本、能耗、产量、故障和工程迭代。';
---

<BaseLayout title="曦清农业 XIQING AGRI | 自动化农业实验" description={description} alternatePath="/en">
	<main>
		<section class="hero shell" aria-labelledby="hero-title">
			<div class="hero__topline">
				<span>FIELD LAB / JIMO · QINGDAO</span>
				<span>EST. 2026</span>
			</div>
			<div class="hero__body">
				<div>
					<p class="eyebrow">XIQING AGRI · OPEN EXPERIMENT LOG</p>
					<h1 id="hero-title">曦清 <span>XIQING</span></h1>
					<p class="hero__claim">把农业做成可以验证的工程</p>
				</div>
				<div class="hero__intro">
					<p class="formula">自然光 × 气雾培 × 自动控制 × 真实数据</p>
					<p>
						曦清正在从零搭建低成本自动化农业系统。<br />
						我们公开记录设计、成本、能耗、产量、故障和每一次迭代。
					</p>
					<a class="button" href={featuredExperiment ? `/experiments/${featuredExperiment.id}` : '/experiments'}>
						查看当前实验 <span aria-hidden="true">↗</span>
					</a>
				</div>
			</div>
			<div class="hero__index" aria-hidden="true">
				<span>01</span><span>公开实验数据库</span><span>SCROLL TO VERIFY</span>
			</div>
		</section>

		{featuredExperiment && (
			<section class="section section--dark" aria-labelledby="current-title">
				<div class="shell">
					<div class="section-heading section-heading--light">
						<p class="eyebrow">CURRENT EXPERIMENT</p>
						<h2 id="current-title">当前实验</h2>
						<span class="status-dot">{statusLabels[featuredExperiment.data.status]}</span>
					</div>

					<div class="experiment-lead">
						<div>
							<p class="experiment-code">{featuredExperiment.data.tower} / {featuredExperiment.data.id}</p>
							<h3>{featuredExperiment.data.title}</h3>
						</div>
						<p>
							{growing?.summary}
						</p>
					</div>

					<div class="metric-grid">
						<MetricCard label="作物" value={featuredExperiment.data.plant} kind="当前种植" />
						<MetricCard label="阶段" value={growing?.phase || statusLabels[featuredExperiment.data.status]} kind="当前状态" />
						{currentBatch?.data.declaredMemberCount != null && <MetricCard label="移栽数量" value={`${currentBatch.data.declaredMemberCount} 株`} kind={formatDate(currentBatch.data.startedAt)} />}
						{growing?.date && <MetricCard label="最近记录" value={formatDate(growing.date)} kind="记录日期" />}
					</div>

					<div class="current-record-links"><a class="text-link text-link--light" href={`/experiments/${featuredExperiment.id}`}>
						查看完整实验记录 <span aria-hidden="true">→</span>
					</a>
					{currentBatch && <a class="text-link text-link--light" href={`/trace/${currentBatch.id}`}>生产批次 {currentBatch.data.displayId} <span aria-hidden="true">→</span></a>}</div>
				</div>
			</section>
		)}

		<section class="section shell" aria-labelledby="verify-title">
			<div class="section-heading">
				<p class="eyebrow">WHAT WE VERIFY</p>
				<h2 id="verify-title">我们正在验证什么</h2>
			</div>
			<div class="question-grid">
				<article><span>01</span><h3>低成本</h3><p>设备是否可以在低投入下长期可靠运行</p></article>
				<article><span>02</span><h3>模块化</h3><p>单塔能否扩展为多塔标准系统</p></article>
				<article><span>03</span><h3>自动化</h3><p>水肥、压力、环境能否持续监测和控制</p></article>
				<article><span>04</span><h3>可验证</h3><p>每一个结论都由真实数据支持</p></article>
			</div>
		</section>

		<section class="section section--tint" aria-labelledby="latest-title">
			<div class="shell">
				<div class="section-heading section-heading--row">
					<div><p class="eyebrow">LATEST EXPERIMENTS</p><h2 id="latest-title">实验记录</h2></div>
					<a class="text-link" href="/experiments">查看全部记录 <span aria-hidden="true">→</span></a>
				</div>
				<div class="experiment-list">
					{latestExperiments.map((experiment) => <ExperimentCard experiment={experiment} />)}
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.current-record-links { display:flex; flex-wrap:wrap; gap:1rem 2rem; }
</style>
