---
import { getCollection } from 'astro:content';
import { isPublicTraceBatch } from '../../lib/public-records';
import TraceBatchCard from '../../components/TraceBatchCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortTraceBatchesNewestFirst } from '../../lib/traceability';

const batches = (await getCollection('traceBatches', isPublicTraceBatch)).sort(sortTraceBatchesNewestFirst);
---

<BaseLayout
	title="产品追溯 | 曦清农业 XIQING AGRI"
	description="按生产批次查看生菜的来源、移栽与日常种植记录。"
	alternatePath="/en/trace"
>
	<main>
		<header class="page-hero shell">
			<p class="eyebrow">追溯记录</p>
			<div class="page-hero__heading"><h1>产品追溯</h1><p>{String(batches.length).padStart(2, '0')} 个批次</p></div>
			<p class="page-hero__intro">按批次查看种植来源、移栽数量、操作和后续记录。</p>
		</header>
		<section class="section section--tint" aria-label="公开生产批次">
			<div class="shell trace-list">{batches.map((batch) => <TraceBatchCard batch={batch} />)}</div>
		</section>
	</main>
</BaseLayout>
