---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { isPublicTraceBatch } from '../../lib/public-records';
import TraceBatchLayout from '../../layouts/TraceBatchLayout.astro';

export async function getStaticPaths() {
	const batches = await getCollection('traceBatches', isPublicTraceBatch);
	return batches.map((batch) => ({ params: { slug: batch.id }, props: { batch } }));
}

interface Props {
	batch: CollectionEntry<'traceBatches'>;
}

const { batch } = Astro.props;
const { Content } = await render(batch);
---

<TraceBatchLayout batch={batch}><Content /></TraceBatchLayout>
