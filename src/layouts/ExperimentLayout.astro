---
import BaseLayout from './BaseLayout.astro';
import { formatDate, statusLabels, type ExperimentStatus } from '../lib/experiments';

interface Props {
	id: string;
	title: string;
	tower: string;
	status: ExperimentStatus;
	startDate: string;
	description: string;
}

const { id, title, tower, status, startDate, description } = Astro.props;
---

<BaseLayout title={`${id} ${title} | 曦清农业`} description={description} type="article">
	<main>
		<header class="record-hero">
			<div class="shell record-hero__inner">
				<p class="eyebrow">EXPERIMENT RECORD / {tower}</p>
				<div class="record-hero__code">
					<span>{id}</span>
					<span class:list={['badge', `badge--${status}`]}>{statusLabels[status]}</span>
				</div>
				<h1>{title}</h1>
				<div class="record-hero__meta"><span>开始日期 {formatDate(startDate)}</span><span>记录原则：未知 ≠ 0</span></div>
			</div>
		</header>
		<slot />
	</main>
</BaseLayout>
